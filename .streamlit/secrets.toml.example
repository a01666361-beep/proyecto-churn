# Ejemplo de .streamlit/secrets.toml (NO subir el archivo real a GitHub: está en .gitignore).
# En Streamlit Cloud se pega en Manage app → Settings → Secrets.
# Cambia cada valor por una contraseña propia; estas son solo marcadores.

GEMINI_API_KEY = "tu_clave_de_gemini"

[acceso]
gerencia = "cambia-esta-contrasena"
operaciones = "cambia-esta-contrasena"
equipo = "cambia-esta-contrasena"
